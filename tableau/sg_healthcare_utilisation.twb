heet name="Data Quality Log"><layout-options><title><formatted-text><run bold='true' fontsize='12'>Data-quality issues found and how they are handled</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Data-quality issues" name="federated.dq" /></datasources><datasource-dependencies datasource="federated.dq"><column caption="Record" datatype="string" name="[record]" role="dimension" type="nominal" /><column caption="Issue" datatype="string" name="[issue]" role="dimension" type="nominal" /><column caption="Handling" datatype="string" name="[handling]" role="dimension" type="nominal" /><column caption="Reported Value" datatype="integer" name="[reported_value]" role="measure" type="quantitative" /><column-instance column="[record]" derivation="None" name="[none:record:nk]" pivot='key' type="nominal" /><column-instance column="[issue]" derivation="None" name="[none:issue:nk]" pivot='key' type="nominal" /><column-instance column="[handling]" derivation="None" name="[none:handling:nk]" pivot='key' type="nominal" /><column-instance column="[reported_value]" derivation="Sum" name="[sum:reported_value:qk]" pivot='key' type="quantitative" /></datasource-dependencies><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Text" /><encodings><text column="[federated.dq].[sum:reported_value:qk]" /></encodings></pane></panes><rows>[federated.dq].[none:record:nk] / [federated.dq].[none:issue:nk] / [federated.dq].[none:handling:nk]</rows><cols></cols></table><simple-id uuid='{A2A70A94-EC11-5B3C-AD2A-35992D216F90}' /></worksheet></worksheets><dashboards><dashboard name="1 Demand"><style /><size maxheight='900' maxwidth='1300' minheight='900' minwidth='1300' /><datasources><datasource caption="Outpatient attendances" name="federated.outpatient" /><datasource caption="Polyclinic conditions" name="federated.conditions" /><datasource caption="Weekly polyclinic attendances" name="federated.weekly" /><datasource caption="Data-quality issues" name="federated.dq" /></datasources><zones><zone h='100000' id='16' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='9000' id='1' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold="true" fontsize='18'>Singapore public outpatient demand, 2006–2021</run><run>Æ&#10;</run><run bold="false" fontsize='11'>Polyclinic attendances 6.69M in 2019 (+77.5% since 2006)  ·  Polyclinic share 47.4% of public outpatient attendances  ·  2 suspected entry errors excluded</run><run>Æ&#10;</run></formatted-text></zone><zone h='45000' id='2' name="Attendances by Care Setting" w='60000' x='0' y='9000' /><zone h='45000' id='3' name="Growth Index" w='40000' x='60000' y='9000' /><zone h='41000' id='4' name="Total Attendances" w='60000' x='0' y='54000' /><zone h='41000' id='5' name="2020 Change by Setting" w='40000' x='60000' y='54000' /><zone h='5000' id='6' type-v2='text' w='100000' x='0' y='95000'><formatted-text><run bold="false" fontsize='9'>Source: Ministry of Health via data.gov.sg (Singapore Open Data Licence). Descriptive statistics only.</run><run>Æ&#10;</run></formatted-text></zone></zone></zones><devicelayouts><devicelayout auto-generated='true' name='Phone'><size maxheight='700' minheight='700' sizing-mode='vscroll' /><zones><zone h='100000' id='17' type-v2='layout-basic' w='100000' x='0' y='0' /></zones></devicelayout></devicelayouts><simple-id uuid='{75B278E5-AD16-59C3-B86B-F62B3626861E}' /></dashboard><dashboard name="2 Chronic Disease"><style /><size maxheight='900' maxwidth='1300' minheight='900' minwidth='1300' /><datasources><datasource caption="Outpatient attendances" name="federated.outpatient" /><datasource caption="Polyclinic conditions" name="federated.conditions" /><datasource caption="Weekly polyclinic attendances" name="federated.weekly" /><datasource caption="Data-quality issues" name="federated.dq" /></datasources><zones><zone h='100000' id='18' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='9000' id='7' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold="true" fontsize='18'>Chronic disease in Singapore's polyclinics, 2006–2025</run><run>Æ&#10;</run><run bold="false" fontsize='11'>Hyperlipidaemia, hypertension and diabetes = 36–42% of all diagnoses each year (36.1% in 2025)  ·  URTI fell from 8.6% (2019) to 3.6% (2021)</run><run>Æ&#10;</run></formatted-text></zone><zone h='46000' id='8' name="Share of Diagnoses" w='100000' x='0' y='9000' /><zone h='40000' id='9' name="Chronic vs Acute" w='100000' x='0' y='55000' /><zone h='5000' id='10' type-v2='text' w='100000' x='0' y='95000'><formatted-text><run bold="false" fontsize='9'>Shares are of all diagnoses (several per visit possible) and exclude preventive-care visits. Source: Ministry of Health via data.gov.sg (Singapore Open Data Licence). Descriptive statistics only.</run><run>Æ&#10;</run></formatted-text></zone></zone></zones><devicelayouts><devicelayout auto-generated='true' name='Phone'><size maxheight='700' minheight='700' sizing-mode='vscroll' /><zones><zone h='100000' id='19' type-v2='layout-basic' w='100000' x='0' y='0' /></zones></devicelayout></devicelayouts><simple-id uuid='{24233785-FA85-5DF0-AA02-BA7B81346C0E}' /></dashboard><dashboard name="3 Weekly Alerts"><style /><size maxheight='900' maxwidth='1300' minheight='900' minwidth='1300' /><datasources><datasource caption="Outpatient attendances" name="federated.outpatient" /><datasource caption="Polyclinic conditions" name="federated.conditions" /><datasource caption="Weekly polyclinic attendances" name="federated.weekly" /><datasource caption="Data-quality issues" name="federated.dq" /></datasources><zones><zone h='100000' id='20' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='9000' id='11' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold="true" fontsize='18'>Weekly polyclinic attendances vs expected range, 2012–2022</run><run>Æ&#10;</run><run bold="false" fontsize='11'>Expected range = mean ± 2 SD of the same weeks in the previous 5 years. 2020: 40–46 of 53 weeks below expected for every acute disease.</run><run>Æ&#10;</run></formatted-text></zone><zone h='86000' id='12' name="Attendances vs Expected" w='58000' x='0' y='9000' /><zone h='66000' id='13' name="Alert Calendar" w='42000' x='58000' y='9000' /><zone h='20000' id='14' name="Data Quality Log" w='42000' x='58000' y='75000' /><zone h='5000' id='15' type-v2='text' w='100000' x='0' y='95000'><formatted-text><run bold="false" fontsize='9'>Screening flags for review, not proof of an outbreak. The rule does not adjust for population growth. Source: Ministry of Health via data.gov.sg (Singapore Open Data Licence). Descriptive statistics only.</run><run>Æ&#10;</run></formatted-text></zone></zone></zones><devicelayouts><devicelayout auto-generated='true' name='Phone'><size maxheight='700' minheight='700' sizing-mode='vscroll' /><zones><zone h='100000' id='21' type-v2='layout-basic' w='100000' x='0' y='0' /></zones></devicelayout></devicelayouts><simple-id uuid='{FA53D3CB-3B82-5CAD-84D9-D0556A2378A6}' /></dashboard></dashboards><windows source-height='30'><window class='dashboard' maximized='true' name="1 Demand"><viewpoints /><active id='-1' /><device-preview visible='false' /><simple-id uuid='{355DE99F-C559-5817-9273-D21A45DBAD3A}' /></window><window class='dashboard' maximized='true' name="2 Chronic Disease"><viewpoints /><active id='-1' /><device-preview visible='false' /><simple-id uuid='{B80BA81B-2D53-593C-BD18-AAE9225FD09D}' /></window><window class='dashboard' maximized='true' name="3 Weekly Alerts"><viewpoints /><active id='-1' /><device-preview visible='false' /><simple-id uuid='{137E0910-5243-504C-87C9-24B90EA77D9B}' /></window><window class='worksheet' name="Attendances by Care Setting"><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'>