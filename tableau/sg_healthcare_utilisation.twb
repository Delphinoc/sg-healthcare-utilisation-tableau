<workbook original-version='18.1' source-build='2024.2.0 (20242.24.0807.0327)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'><document-format-change-manifest><SheetIdentifierTracking /><WindowsPersistSimpleIdentifiers /></document-format-change-manifest><preferences><preference name='ui.encoding.shelf.height' value='24' /><preference name='ui.shelf.height' value='26' /></preferences><datasources><datasource caption="Outpatient attendances" inline='true' name="federated.outpatient" version='18.1'><connection class='federated'><named-connections><named-connection caption="outpatient_annual" name="textscan.outpatient_annual"><connection class='textscan' directory='Data/extracts' filename="outpatient_annual.csv" password='' server='' /></named-connection></named-connections><relation connection="textscan.outpatient_annual" name="outpatient_annual.csv" table="[outpatient_annual#csv]" type='table'><columns character-set='UTF-8' header='yes' locale='en_GB' separator=','><column datatype="integer" name="year" ordinal='0' /><column datatype="string" name="care_setting" ordinal='1' /><column datatype="string" name="care_setting_short" ordinal='2' /><column datatype="string" name="care_level" ordinal='3' /><column datatype="integer" name="sort_order" ordinal='4' /><column datatype="integer" name="attendances_reported" ordinal='5' /><column datatype="real" name="attendances_validated" ordinal='6' /><column datatype="real" name="yoy_change_pct" ordinal='7' /><column datatype="real" name="index_2006_eq_100" ordinal='8' /><column datatype="real" name="neighbour_ratio" ordinal='9' /><column datatype="string" name="dq_status" ordinal='10' /><column datatype="real" name="year_total_validated" ordinal='11' /><column datatype="real" name="year_polyclinic_share" ordinal='12' /></columns></relation></connection><aliases enabled='yes' /><column caption="Year" datatype="integer" name="[year]" role="dimension" type="ordinal" /><column caption="Car