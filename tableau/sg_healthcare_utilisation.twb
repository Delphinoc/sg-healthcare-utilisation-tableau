datatype="string" name="[alert_status]" role="dimension" type="nominal" /><column caption="Dq Note" datatype="string" name="[dq_note]" role="dimension" type="nominal" /><column caption="Attendances vs Expected" datatype='real' name="[Calculation_pct_expected]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([avg_daily_attendances]) / SUM([baseline_mean])" /></column><layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' /><style><style-rule element='mark'><encoding attr='color' field="[none:alert_status:nk]" type='palette'><map to="#C8553D"><bucket>"Above expected"</bucket></map><map to="#3A7CA5"><bucket>"Below expected"</bucket></map><map to="#D9D9D9"><bucket>"Within expected"</bucket></map><map to="#F4F4F4"><bucket>"No baseline"</bucket></map></encoding></style-rule></style><semantic-values><semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' /></semantic-values></datasource><datasource caption="Data-quality issues" inline='true' name="federated.dq" version='18.1'><connection class='federated'><named-connections><named-connection caption="dq_issues" name="textscan.dq_issues"><connection class='textscan' directory='Data/extracts' filename="dq_issues.csv" password='' server='' /></named-connection></named-connections><relation connection="textscan.dq_issues" name="dq_issues.csv" table="[dq_issues#csv]" type='table'><columns character-set='UTF-8' header='yes' locale='en_GB' separator=','><column datatype="string" name="dataset" ordinal='0' /><column datatype="string" name="record" ordinal='1' /><column datatype="integer" name="reported_value" ordinal='2' /><column datatype="string" name="issue" ordinal='3' /><column datatype="string" name="rule" ordinal='4' /><column datatype="string" name="handling" ordinal='5' /></columns></relation></connection><aliases enabled='yes' /><column caption="Dataset" datatype="string" name="[dataset]" role="dimension" type="nominal" /><column caption="Record" datatype="string" name="[record]" role="dimension" type="nominal" /><column caption="Reported Value" datatype="integer" name="[reported_value]" role="measure" type="quantitative" /><column caption="Issue" datatype="string" name="[issue]" role="dimension" type="nominal" /><column caption="Rule" datatype="string" name="[rule]" role="dimension" type="nominal" /><column caption="Handling" datatype="string" name="[handling]" role="dimension" type="nominal" /><layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' /><style></style><semantic-values><semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' /></semantic-values></datasource></datasources><worksheets><worksheet name="Attendances by Care Setting"><layout-options><title><formatted-text><run bold='true' fontsize='12'>Annual attendances by care setting (validated; gaps = suspected entry errors)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Outpatient attendances" name="federated.outpatient" /></datasources><datasource-dependencies datasource="federated.outpatient"><column caption="Attendances Validated" datatype="real" name="[attendances_validated]" role="measure" type="quantitative" /><column caption="Year" datatype="integer" name="[year]" role="dimension" type="ordinal" /><column caption="Care Setting Short" datatype="string" name="[care_setting_short]" role="dimension" type="nominal" /><column-instance column="[attendances_validated]" derivation="Sum" name="[sum:attendances_validated:qk]" pivot='key' type="quantitative" /><column-instance column="[year]" derivation="None" name="[none:year:ok]" pivot='key' type="ordinal" /><column-instance column="[care_setting_short]" derivation="None" name="[none:care_setting_short:nk]" pivot='key' type="nominal" /></datasource-dependencies><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Line" /><encodings><color column="[federated.outpatient].[none:care_setting_short:nk]" /></encodings></pane></panes><rows>[federated.outpatient].[sum:attendances_validated:qk]</rows><cols>[federated.outpatient].[none:year:ok]</cols></table><simple-id uuid='{352201EE-3FB0-5994-A767-FD1C172B1A66}' /></worksheet><worksheet name="Growth Index"><layout-options><title><formatted-text><run bold='true' fontsize='12'>Growth index (2006 = 100): polyclinics grew fastest, +77.5% by 2019</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Outpatient attendances" name="federated.outpatient" /></datasources><datasource-dependencies datasource="federated.outpatient"><column caption="Index 2006 Eq 100" datatype="real" name="[index_2006_eq_100]" role="measure" type="quantitative" /><column caption="Year" datatype="integer" name="[year]" role="dimension" type="ordinal" /><column caption="Care Setting Short" datatype="string" name="[care_setting_short]" role="dimension" type="nominal" /><column-instance column="[index_2006_eq_100]" derivation="Sum" name="[sum:index_2006_eq_100:qk]" pivot='key' type="quantitative" /><column-instance column="[year]" derivation="None" name="[none:year:ok]" pivot='key' type="ordinal" /><column-instance column="[care_setting_short]" derivation="None" name="[none:care_setting_short:nk]" pivot='key' type="nominal" /></datasource-dependencies><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Line" /><encodings><color column="[federated.outpatient].[none:care_setting_short:nk]" /></encodings></pane></panes><rows>[federated.outpatient].[sum:index_2006_eq_100:qk]</rows><cols>[federated.outpatient].[none:year:ok]</cols></table><simple-id uuid='{B2215692-6D95-5FAE-A629-51965FD72DC4}' /></worksheet><workshee